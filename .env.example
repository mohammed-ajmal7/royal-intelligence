# Example configuration only. NEVER commit real API credentials.
# Add your actual secret in Vercel → Project Settings → Environment Variables.
CLASH_API_TOKEN=
# Use the official API if your server has an allowlisted static IP.
# For dynamic-IP hosts using the optional RoyaleAPI proxy, allowlist its documented IP.
CLASH_API_BASE=https://proxy.royaleapi.dev/v1
DISPLAY_LEVEL_CAP=16
# Standalone only. Sites uses trusted signed-in identity.
APP_ACCESS_KEY=
